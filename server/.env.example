NODE_ENV=production
PUBLIC_SITE_ORIGIN=https://lilyplan.vip
TABLESTORE_INSTANCE=lilyplan-prod
TABLESTORE_ENDPOINT=https://lilyplan-prod.cn-hongkong.vpc.tablestore.aliyuncs.com
OSS_REGION=oss-cn-hongkong
OSS_ENDPOINT=https://oss-cn-hongkong-internal.aliyuncs.com
OSS_BUCKET=lilyplan-files-cavium
COOKIE_SECURE=true

# Optional overrides. Keep these defaults when the tables use the documented names.
TABLE_ADMINS=lp_admins
TABLE_REPORTS=lp_reports
TABLE_ACCESS_CODES=lp_access_codes
TABLE_SESSIONS=lp_sessions
TABLE_ATTACHMENTS=lp_attachments
TABLE_RATE_LIMITS=lp_rate_limits
TABLE_ACCESS_EVENTS=lp_access_events
